# harbor-canary GUID $canary
# GENERATED by `evals generate`. Do not edit by hand.
# Dedicated verifier image: the same baseline as the agent, warmed with the
# hidden tests compiled, so grading runs fully offline.
FROM $go_image

ENV GOFLAGS=-mod=mod GOTOOLCHAIN=auto CGO_ENABLED=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/rk \
 && /opt/rk/bin/pip install --no-cache-dir harbor-rewardkit==0.2.1

RUN mkdir -p /app/$repo_dir \
 && cd /app/$repo_dir \
 && git init -q \
 && git fetch -q --depth 1 $repo $parent \
 && git checkout -q FETCH_HEAD \
 && rm -rf .git \
 && git init -q \
 && git -c user.email=eval@auto-stack -c user.name=eval add -A \
 && git -c user.email=eval@auto-stack -c user.name=eval commit -qm baseline

COPY . /tests/

# Compile the hidden tests once so the offline run hits a warm cache, then
# restore the pristine baseline.
RUN cd /app/$repo_dir && go mod download \
 && cp -r /tests/hidden/. . \
 && go test -count=1 -run '^$$' $packages \
 && git checkout -q -- . && git clean -qfd \
 && chmod +x /tests/test.sh

WORKDIR /app/$repo_dir
