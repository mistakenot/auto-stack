# harbor-canary GUID $canary
# GENERATED by `evals generate`. Do not edit by hand.
FROM $go_image

ENV GOFLAGS=-mod=mod GOTOOLCHAIN=auto CGO_ENABLED=0

# Fixture: $repo at the parent of the fix commit. Upstream history is replaced
# by a single local baseline commit, so the fix is not reachable from here and
# the agent's edits can be collected as a diff against it.
RUN mkdir -p /app/$repo_dir \
 && cd /app/$repo_dir \
 && git init -q \
 && git fetch -q --depth 1 $repo $parent \
 && git checkout -q FETCH_HEAD \
 && rm -rf .git \
 && git init -q \
 && git -c user.email=eval@auto-stack -c user.name=eval add -A \
 && git -c user.email=eval@auto-stack -c user.name=eval commit -qm baseline

# Warm the module and build caches so the agent's first build is fast.
RUN cd /app/$repo_dir && go mod download && go build ./... && go test -count=1 -run '^$$' $packages

WORKDIR /app/$repo_dir
