#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# --- 1. goimports + gofmt: auto-fix staged .go files and re-stage ---
# goimports is a superset of gofmt — it formats AND fixes unused/missing imports.

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo "$STAGED_GO_FILES" | while IFS= read -r f; do
        if [ -f "$ROOT/$f" ]; then
            if command -v goimports &>/dev/null; then
                goimports -w "$ROOT/$f"
            else
                gofmt -w "$ROOT/$f"
            fi
        fi
    done
    echo "$STAGED_GO_FILES" | xargs -I{} git add "$ROOT/{}"
    echo "pre-commit: goimports/gofmt applied"
fi

# --- 2. lint: golangci-lint (includes govet), scoped to staged .go files only ---
# We scope to staged packages so pre-existing lint failures in unmodified code
# don't block commits. The full `make lint` still runs in CI.

if [ -n "$STAGED_GO_FILES" ]; then
    # Group staged Go files by their sub-project directory, then lint only
    # the packages that contain staged files.
    staged_projects=$(echo "$STAGED_GO_FILES" | cut -d/ -f1 | sort -u)
    lint_failed=0
    for proj in $staged_projects; do
        # Collect unique package directories within this project
        pkg_dirs=$(echo "$STAGED_GO_FILES" | grep "^${proj}/" | xargs -I{} dirname {} | sed "s|^${proj}/||" | sort -u)
        # Convert to Go package paths (prefix with ./)
        pkg_paths=""
        for d in $pkg_dirs; do
            if [ "$d" = "$proj" ] || [ -z "$d" ]; then
                pkg_paths="$pkg_paths ."
            else
                pkg_paths="$pkg_paths ./$d"
            fi
        done
        # Deduplicate package paths
        pkg_paths=$(echo "$pkg_paths" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
        if [ -n "$pkg_paths" ]; then
            echo "pre-commit: linting staged packages in $proj: $pkg_paths"
            (cd "$ROOT/$proj" && golangci-lint run $pkg_paths) || lint_failed=1
        fi
    done
    if [ $lint_failed -ne 0 ]; then
        echo "pre-commit: lint failed on staged packages"
        exit 1
    fi
    echo "pre-commit: lint passed"
fi

# --- 3. autodoc fix: validate doc-code freshness links ---

if command -v autodoc &>/dev/null; then
    autodoc fix
    git add "$ROOT" 2>/dev/null || true
    echo "pre-commit: autodoc fix passed"
fi

# --- 4. skills sync: reinstall all local skills if any changed ---

STAGED_SKILL_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- 'skills/' || true)

if [ -n "$STAGED_SKILL_FILES" ] && command -v npx &>/dev/null; then
    npx skills install "$ROOT/skills" -y 2>/dev/null || true
    git add "$ROOT/.agents/" 2>/dev/null || true
    echo "pre-commit: skills synced"
fi

# --- 5. br sync: flush beads to JSONL ---

if command -v br &>/dev/null && [ -d "$ROOT/.beads" ]; then
    br sync --flush-only --quiet 2>/dev/null || true
    git add "$ROOT/.beads/" 2>/dev/null || true
    echo "pre-commit: beads synced"
fi
